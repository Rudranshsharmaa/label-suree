# LabelSure Production/Development Environment Variables Example
# Copy this file to backend/.env and populate with your environment-specific credentials

APP_ENV=development
PROJECT_NAME="LabelSure Security Platform"
VERSION=3.3.0

# 64-char Cryptographically Secure Hex Secret Key (Generate with: openssl rand -hex 32)
SECRET_KEY=your_64_character_hex_secret_key_here_for_jwt_signature

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=15

# AI Configuration & Cost Protection
GEMINI_API_KEY=your_gemini_api_key_here
MAX_SCANS_PER_USER_DAILY=20
MAX_SCANS_PER_USER_MONTHLY=200
GLOBAL_DAILY_GEMINI_CALL_LIMIT=1000

# SMTP & Password Reset Email Settings (Leave SMTP_ENABLED=false for local dev mock)
SMTP_ENABLED=false
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=security@labelsure.io
FRONTEND_URL=http://localhost:5173

# Storage & Database
DATABASE_URL=sqlite:///./backend/data/labelsure_secure.db
UPLOAD_DIR=./backend/uploads
